# Estado runtime del servidor: config sembrada (data/) y assets subidos por el panel (assets/).
# No es código; se genera al ejecutar y no debe versionarse.
src/Kiosk.Server/data/
src/Kiosk.Server/assets/
src/Kiosk.Server/installers/
src/Kiosk.Server/setups/
src/Kiosk.Server/updates/

# Visual Studio / Rider files
.vs/
.idea/
*.suo
*.user
*.userosscache
*.sln.docstates

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# Visual Studio cache/options
.vs/
# Rider cache/options
.idea/

# ReSharper
_ReSharper*/
*.[Rr]e[Ss]harper
*.DotSettings.user

# NuGet Packages
*.nupkg
# NuGet Symbol Packages
*.snupkg
# The packages folder can be ignored because of Package Restore
**/[Pp]ackages/*
# except build/, which is used as an MSBuild target.
!**/[Pp]ackages/build/

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# Artefactos del instalador (dotnet publish + Inno Setup)
publish/
publish-agent/
publish-maintenance/
publish-setup-helper/
publish-update-runner/
equipment-build/
panel-vps/
panel-vps.zip
installer/Output/

# Instaladores de terceros: se conservan localmente, no en el repositorio público.
instaladores/*.exe
instaladores/*.msi

# Accidental shell artifacts. The pre-commit hook rejects extensionless files
# added at the repository root.

# Copia original del portátil conservada durante la consolidación
/KioskClinicaPC/
