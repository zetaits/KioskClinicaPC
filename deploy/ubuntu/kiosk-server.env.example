# Copiar a /etc/kiosk-server/kiosk-server.env, sustituir los valores y proteger con chmod 600.
# Genera secretos distintos con: openssl rand -hex 32
Kiosk__ApiKey=REEMPLAZAR_API_KEY
Kiosk__InitialSetupKey=REEMPLAZAR_CLAVE_SETUP_INICIAL
Kiosk__PanelInitialPassword=REEMPLAZAR_PASSWORD_PANEL
Kiosk__DataDir=/var/lib/kiosk-server/data
Kiosk__AssetsDir=/var/lib/kiosk-server/assets
Kiosk__InstallersDir=/var/lib/kiosk-server/installers
Kiosk__SetupDir=/var/lib/kiosk-server/setups
Kiosk__TimeZone=Europe/Madrid
Kiosk__SlideDurationMs=5200
AllowedHosts=panel.ejemplo.com;localhost;127.0.0.1
