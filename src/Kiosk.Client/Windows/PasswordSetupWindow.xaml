<Window x:Class="KioskClinicaPC.Windows.PasswordSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configurar contraseña"
        Height="455" Width="520"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="{StaticResource Bg0Brush}"
        Foreground="White"
        FontFamily="{StaticResource SpaceGrotesk}"
        BorderBrush="{StaticResource CyanBrush}"
        BorderThickness="1">
    <Grid Margin="34,30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,22">
            <TextBlock x:Name="TitleText" Text="Protege los ajustes del kiosko"
                       FontFamily="{StaticResource ChakraPetch}" FontSize="24" FontWeight="Bold"/>
            <TextBlock x:Name="IntroText" Margin="0,7,0,0" Foreground="{StaticResource Text2Brush}"
                       FontSize="13" TextWrapping="Wrap" LineHeight="20"/>
        </StackPanel>

        <Border Grid.Row="1" Background="#1FF37A4A" BorderBrush="{StaticResource CyanBrush}"
                BorderThickness="1" CornerRadius="9" Padding="13" Margin="0,0,0,20">
            <TextBlock Text="La contraseña no se envía al servidor: se guarda únicamente como hash en este equipo."
                       Foreground="{StaticResource Text1Brush}" FontSize="12" TextWrapping="Wrap"/>
        </Border>

        <StackPanel Grid.Row="2">
            <StackPanel x:Name="CurrentPasswordSection" Margin="0,0,0,14">
                <TextBlock Text="CONTRASEÑA ACTUAL" FontFamily="{StaticResource JetBrainsMono}"
                           FontSize="10" Foreground="{StaticResource Text2Brush}" Margin="2,0,0,7"/>
                <PasswordBox x:Name="CurrentPasswordBox" Style="{StaticResource ConfigPasswordBox}"/>
            </StackPanel>
            <StackPanel Margin="0,0,0,14">
                <TextBlock Text="NUEVA CONTRASEÑA · MÍNIMO 12 CARACTERES"
                           FontFamily="{StaticResource JetBrainsMono}" FontSize="10"
                           Foreground="{StaticResource Text2Brush}" Margin="2,0,0,7"/>
                <PasswordBox x:Name="NewPasswordBox" Style="{StaticResource ConfigPasswordBox}"/>
            </StackPanel>
            <StackPanel>
                <TextBlock Text="CONFIRMAR NUEVA CONTRASEÑA" FontFamily="{StaticResource JetBrainsMono}"
                           FontSize="10" Foreground="{StaticResource Text2Brush}" Margin="2,0,0,7"/>
                <PasswordBox x:Name="ConfirmPasswordBox" Style="{StaticResource ConfigPasswordBox}"/>
            </StackPanel>
            <TextBlock x:Name="ErrorText" Visibility="Collapsed" Margin="2,12,0,0"
                       Foreground="#FFFF7A7A" FontSize="12" TextWrapping="Wrap"/>
        </StackPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,26,0,0">
            <Button Content="Salir" Style="{StaticResource SecondaryButton}" Padding="18,9"
                    Margin="0,0,10,0" Click="CancelButton_Click" IsCancel="True"/>
            <Button Content="Guardar contraseña" Style="{StaticResource PrimaryButton}" Padding="22,9"
                    Click="SaveButton_Click" IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>
