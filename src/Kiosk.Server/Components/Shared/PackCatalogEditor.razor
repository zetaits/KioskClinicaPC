@using KioskClinicaPC.Core.Sync
@inject PackCatalogStore Catalog

@{
    var pack = Catalog.Definition();
    var results = Catalog.Search(_query);
    int selectedCount = pack.Applications.Count(x => x.SelectedByDefault);
    bool indexReady = Catalog.IndexUpdatedAtUtc != DateTime.MinValue;
}

<section class="card setup-section pack-editor" id="pack-applications" data-pack-count="@pack.Applications.Count" data-preselected-count="@selectedCount">
    <div class="card-head">
        <div><h2>Aplicaciones del pack</h2><p class="muted section-copy">Esta es la lista que aparecerá en el instalador de equipos.</p></div>
        <div class="catalog-actions pack-header-actions">
            <a class="btn primary button-link" href="/instalador">Ir al instalador</a>
        </div>
    </div>
    <span class="setup-count">@(pack.Applications.Count == 1 ? "1 aplicación" : $"{pack.Applications.Count} aplicaciones") · @(selectedCount == 1 ? "1 seleccionada por defecto" : $"{selectedCount} seleccionadas por defecto")</span>
    <p class="muted">Los cambios se guardan automáticamente. Se aplican al cargar el pack en el ordenador que vayas a preparar, sin necesidad de registrarlo en la flota.</p>
    @if (_message is not null) { <p class="alert @(_error ? "error" : "success")" role="status">@_message</p> }
    @if (pack.Applications.Count == 0)
    {
        <div class="empty-state compact"><div class="empty-icon">▣</div><div><b>Todavía no hay aplicaciones en el pack</b><p>Usa el buscador de abajo y pulsa Añadir al pack.</p></div></div>
    }
    else
    {
        <div class="catalog-list">
            @foreach (var app in pack.Applications)
            {
                var latest = Catalog.Search(app.WingetId).FirstOrDefault(x => x.Id.Equals(app.WingetId, StringComparison.OrdinalIgnoreCase));
                <article class="catalog-item" @key="app.Id" data-pack-application="@app.WingetId">
                    <div class="app-mark" aria-hidden="true">APP</div>
                    <div class="catalog-main"><strong>@app.DisplayName</strong><span>Última versión compatible al instalar</span><code>@app.WingetId</code>
                        @if (latest is not null)
                        {
                            <span class="muted">Versión observada en el índice: @latest.Version</span>
                            @if (!latest.Eligible) { <span class="muted">@latest.Reason Se comprobará de nuevo en el equipo.</span> }
                        }
                        else { <span class="muted">Sin entrada en el índice actual. Se conserva la aplicación y se comprobará en el equipo.</span> }
                    </div>
                    <div class="catalog-meta">
                        <label class="check-row"><input type="checkbox" checked="@app.SelectedByDefault" @onchange="e => Change(() => Catalog.Configure(app.Id, (bool)(e.Value ?? false), app.Order))" /> Seleccionada por defecto</label>
                        <label class="setup-order">Orden de instalación <input aria-label="@($"Orden de instalación de {app.DisplayName}")" type="number" min="0" max="10000" value="@app.Order" @onchange="e => SetOrder(app, e.Value)" /></label>
                    </div>
                    <div class="catalog-actions"><button type="button" class="danger" @onclick="() => Change(() => Catalog.Remove(app.Id))">Quitar del pack</button></div>
                </article>
            }
        </div>
        <p class="muted">Puedes cambiar la selección en cada ordenador antes de instalar. Los números de orden menores se instalan primero. Quitar una app del pack no la desinstala de ningún equipo.</p>
    }
    <p class="muted">Cada equipo consulta WinGet al comenzar y resuelve las versiones compatibles. Las aplicaciones no disponibles quedan pendientes y las demás pueden instalarse. Las versiones del índice son orientativas.</p>
</section>

<section class="card setup-section">
    <div class="card-head">
        <div><h2>Añadir aplicaciones al pack</h2><p class="muted section-copy">Busca en el catálogo oficial de WinGet. Al añadir una aplicación, aparecerá en la lista de arriba.</p></div>
        <span class="badge accent">WinGet</span>
    </div>
    <div class="field">
        <label for="pack-search">Buscar aplicación</label>
        <input type="text" id="pack-search" placeholder="Nombre o identificador, por ejemplo Google.Chrome"
               autocomplete="off" disabled="@(!indexReady)" @bind="_query" @bind:event="oninput" aria-describedby="pack-index-status" />
    </div>
    @if (!indexReady)
    {
        <p id="pack-index-status" class="alert warning" role="status">El catálogo de WinGet está pendiente de su primera importación. Las aplicaciones que ya tenga tu pack se conservan.</p>
    }
    else
    {
        <p id="pack-index-status" class="muted">Catálogo WinGet actualizado: @Catalog.IndexUpdatedAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm"). Escribe al menos dos caracteres para buscar.</p>
        @if (Catalog.IndexUpdatedAtUtc < DateTime.UtcNow.AddHours(-48))
        {
            <p class="alert warning" role="status">El índice lleva más de 48 horas sin renovarse. Se conserva el último catálogo válido; el asistente consultará WinGet en cada equipo.</p>
        }
    }
    @if (indexReady && _query.Trim().Length >= 2 && results.Count == 0)
    {
        <p class="muted" role="status">No hay resultados para esta búsqueda. Prueba otro nombre o identificador.</p>
    }
    @if (results.Count > 0)
    {
        <div class="catalog-list" aria-label="Resultados del catálogo WinGet">
            @foreach (var app in results)
            {
                var added = pack.Applications.FirstOrDefault(x => x.WingetId.Equals(app.Id, StringComparison.OrdinalIgnoreCase));
                <article class="catalog-item" @key="app.Id">
                    <div class="app-mark" aria-hidden="true">APP</div>
                    <div class="catalog-main"><strong>@app.Name</strong><span>@app.Publisher · Versión observada: @app.Version</span><code>@app.Id</code></div>
                    <div class="catalog-meta">
                        <span class="badge @(app.Eligible ? "ok" : "warn")">@(app.Eligible ? "Instalación desatendida" : "No compatible con el pack")</span>
                        @if (!app.Eligible) { <span class="muted">@app.Reason</span> }
                    </div>
                    <div class="catalog-actions">
                        @if (added is not null) { <span class="badge ok">En el pack · última compatible</span> }
                        else if (app.Eligible) { <button type="button" @onclick="() => Change(() => Catalog.Add(app.Id))">Añadir al pack</button> }
                    </div>
                </article>
            }
        </div>
    }
</section>

@code {
    private string _query = "";
    private string? _message;
    private bool _error;
    private void Change(Action action)
    {
        try { action(); _message = "Pack guardado."; _error = false; }
        catch (Exception ex) { _message = ex.Message; _error = true; }
    }
    private void SetOrder(PackEntry app, object? value)
    {
        if (!int.TryParse(value?.ToString(), out int order)) { _message = "Introduce un orden entre 0 y 10000."; _error = true; return; }
        Change(() => Catalog.Configure(app.Id, app.SelectedByDefault, order));
    }
}
