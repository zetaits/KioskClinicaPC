<section class="card" aria-busy="@(State.Status == InstallerSectionStatus.Loading ? "true" : "false")">
    <h2>Instalar sistemas por red</h2>
    <p>ClínicaPC · Instalación por red. Instálalo en el PC del encargado para preparar otros equipos por Ethernet. Importa una ISO oficial y gestiona los perfiles en <a href="/despliegue">Instalación de sistemas</a>.</p>
    @if (State.Status == InstallerSectionStatus.Ready && State.Data is { } data)
    {
        <div class="setup-download-action">
            <a class="btn primary button-link setup-download-button" href="@($"/panel/deployment/download?version={Uri.EscapeDataString(data.Version)}")" data-setup-download data-download-cookie="kioskDeploymentDownload">
                <span class="setup-spinner" aria-hidden="true"></span><span data-setup-download-label>Descargar instalación por red @data.Version</span>
            </a>
            <p class="setup-download-status" data-setup-download-status hidden role="status"></p>
        </div>
    }
    else if (State.Status == InstallerSectionStatus.Loading)
    {
        <span class="installer-skeleton installer-skeleton-button installer-skeleton-deployment" aria-hidden="true"></span>
        <p class="installer-visually-hidden" role="status">Cargando instalación por red…</p>
    }
    else if (State.Status == InstallerSectionStatus.Error)
    {
        <div class="alert" role="status"><p>@State.Message</p><button class="btn" type="button" @onclick="OnRetry">Reintentar</button></div>
    }
    else { <p class="alert" role="status">Todavía no hay una versión publicada y validada para instalación por red.</p> }
    <p class="muted">Encargado: Windows 11 x64, administrador y Ethernet en la misma red. Destinos: UEFI y arranque PXE por Ethernet. Conectar el cable no basta: hay que encender el equipo y elegir el arranque por red.</p>
    <a href="/despliegue/guia">Guía inicial y recuperación</a>
</section>

@code {
    [Parameter, EditorRequired] public InstallerSectionState<DeploymentSectionData> State { get; set; } = InstallerSectionState<DeploymentSectionData>.Loading();
    [Parameter] public EventCallback OnRetry { get; set; }
}
