@page "/"
@attribute [Authorize]
@rendermode InteractiveServer
@implements IDisposable
@using Kiosk.Server.Hubs
@using KioskClinicaPC.Core.Sync
@inject ContentResolver Content
@inject FleetRegistry Fleet
@inject IHubContext<SyncHub> Hub
@inject IHubContext<FleetHub> FleetHubCtx

<div class="stat-grid">
    <div class="stat">
        <div class="k">Equipos conectados</div>
        <div class="v">@_onlineCount<small> / @_devices.Count</small></div>
        <div class="bars">
            @foreach (var d in _devices)
            {
                <span class="@(d.IsOnline ? "" : "off")"></span>
            }
        </div>
    </div>

    <div class="stat @(_activeEvent is not null ? "accent" : "")">
        <div class="k">Evento activo</div>
        @if (_activeEvent is not null)
        {
            <div class="v small">@_activeEvent.Name</div>
            <div class="f">Hasta @_activeEvent.End.ToString("dd MMM", _es)</div>
        }
        else
        {
            <div class="v small">Ninguno</div>
            <div class="f">Contenido habitual de la tienda</div>
        }
    </div>

    <div class="stat">
        <div class="k">En uso ahora</div>
        <div class="v">@_busyCount</div>
        <div class="f">Equipos mostrando ficha o detalle</div>
    </div>

    <div class="stat @(_offlineCount > 0 ? "offline-alert" : "")">
        <div class="k">Sin conexión</div>
        <div class="v">@_offlineCount</div>
        @if (_offline is not null)
        {
            <div class="f bad">@_offline.Name sin conexión</div>
        }
        else if (_onlineCount > 0)
        {
            <div class="f ok">Todos los equipos conectados</div>
        }
        else
        {
            <div class="f">Sin equipos conectados</div>
        }
    </div>
</div>

<div class="split dashboard-split">
    <div class="card">
        <div class="card-head">
            <h2>Estado de la flota</h2>
            <a class="link" href="/ordenadores">Ver equipos →</a>
        </div>
        @if (_devices.Count == 0)
        {
            <div class="dashboard-empty">
                <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><rect x="2.5" y="4" width="19" height="12" rx="2" /><path d="M8 20h8M12 16v4" /></svg>
                <h3>Aún no hay equipos conectados</h3>
                <p>Cuando un kiosco se conecte al servidor, podrás consultar aquí su estado.</p>
                <a class="btn" href="/instalador">Preparar un equipo</a>
            </div>
        }
        else
        {
            <div class="fleet-list">
                @foreach (var d in _devices)
                {
                    <div class="r">
                        <span class="dot @FleetRegistry.StatusCss(d.Status)" title="@FleetRegistry.StatusLabel(d.Status)"></span>
                        <div class="device-info">
                            <div class="n">@d.Name</div>
                            <div class="e">@d.Equipment</div>
                        </div>
                        <span class="screen-badge @FleetRegistry.ScreenCss(d.Screen)">@FleetRegistry.ScreenLabel(d.Screen)</span>
                        <div class="p">@PriceLabel(d)</div>
                    </div>
                }
            </div>
        }
    </div>

    <div class="card activity-card">
        <div class="card-head">
            <h2 id="activity-title">Actividad reciente</h2>
            <span class="activity-count">@_activity.Count registros</span>
        </div>
        <div class="activity" role="region" aria-labelledby="activity-title" tabindex="0">
            @if (_activity.Count == 0)
            {
                <p class="activity-empty">Todavía no hay actividad. Aquí aparecerán las conexiones y los cambios de la flota.</p>
            }
            else
            {
                <ol class="activity-list">
                    @foreach (var a in _activity)
                    {
                        <li><span class="t">@a.Time</span><span class="message">@a.Message</span></li>
                    }
                </ol>
            }
        </div>
        <div class="activity-actions">
            <button class="primary block" @onclick="SyncNow">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M21 12a9 9 0 1 1-2.6-6.4M21 4v4h-4" /></svg>Sincronizar contenido ahora
            </button>
            <button class="block" @onclick="RestartApps">Reiniciar app kiosko en todos</button>
        </div>
    </div>
</div>

<Toast Message="@_toast" />

@code {
    private static readonly System.Globalization.CultureInfo _es = new("es-ES");

    private IReadOnlyList<FleetDevice> _devices = Array.Empty<FleetDevice>();
    private IReadOnlyList<FleetActivity> _activity = Array.Empty<FleetActivity>();
    private int _onlineCount;
    private int _offlineCount;
    private KioskEvent? _activeEvent;
    private FleetDevice? _offline;
    private int _busyCount;
    private string? _toast;

    protected override void OnInitialized()
    {
        Refresh();
        Fleet.Changed += OnFleetChanged;
    }

    public void Dispose() => Fleet.Changed -= OnFleetChanged;

    private void OnFleetChanged() => InvokeAsync(() => { Refresh(); StateHasChanged(); });

    private void Refresh()
    {
        _devices = Fleet.Devices;
        _activity = Fleet.RecentActivity();
        _onlineCount = _devices.Count(d => d.IsOnline);
        _offlineCount = _devices.Count - _onlineCount;
        _activeEvent = Content.ActiveEvent();
        _offline = _devices.FirstOrDefault(d => !d.IsOnline);
        _busyCount = _devices.Count(d => d.Status == KioskStatus.Busy);
    }

    private static string PriceLabel(FleetDevice d) =>
        d.Price > 0 ? d.Price.ToString("N0", _es) + " €" : "—";

    // Empuja el contenido efectivo a los kioscos conectados sin esperar a su refresco periódico.
    private async Task SyncNow()
    {
        await Hub.Clients.All.SendAsync("ContentChanged");
        _toast = "Sincronización enviada a los kioscos conectados.";
    }

    // Reinicia la app kiosko en todos los equipos online.
    private async Task RestartApps()
    {
        var ids = Fleet.OnlineConnectionIds();
        if (ids.Count == 0) { _toast = "No hay equipos online a los que enviar la orden."; return; }
        await FleetHubCtx.Clients.Clients(ids).SendAsync("Command", FleetCommand.RestartApp());
        _toast = $"Reinicio de la app enviado a {ids.Count} equipo(s).";
    }
}
