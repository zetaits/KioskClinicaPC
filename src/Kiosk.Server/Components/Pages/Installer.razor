@page "/instalador"
@attribute [Authorize]
@attribute [StreamRendering]
@rendermode InteractiveServer
@using Kiosk.Server.Components.Shared.Installer

<div class="setup-page">
    <h2>Instalador de equipos</h2>
    <EquipmentInstallerSection State="Setup!" OnRetry="RetrySetupAsync" />
    <DeploymentInstallerSection State="Deployment!" OnRetry="RetryDeploymentAsync" />
    @if (Setup is { Status: InstallerSectionStatus.Ready, Data: { } data })
    {
        <InstallerHistory DisplayedVersion="data.Latest.Version" ActiveVersion="data.ActiveVersion" />
    }
</div>
