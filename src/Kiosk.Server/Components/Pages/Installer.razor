@page "/instalador"
@attribute [Authorize]
@rendermode InteractiveServer
@using KioskClinicaPC.Core.Sync
@inject InitialSetupBundleStore Bundles
@inject PackCatalogStore Catalog

<section class="card setup-hero">
    <h2>Preparar un ordenador</h2>
    <p>Descarga y ejecuta el instalador en el ordenador que vas a preparar. No necesita pertenecer a la flota. El pack está seleccionado por defecto; Kiosk es opcional.</p>
    @if (_bundle is not null)
    {
        <a class="btn primary button-link" href="/panel/setup/download" data-setup-download><span data-setup-download-label>Descargar instalador @_bundle.Manifest.Version</span></a>
        <p data-setup-download-status hidden role="status"></p>
    }
    else { <p class="alert error">@(_bundleError ?? "Todavía no se ha publicado el instalador interno.")</p> }
    <p class="muted">Windows 10 22H2 / Windows 11 x64 · Internet · Administrador. El progreso y el resultado se muestran solo en ese ordenador. Nunca reinicia automáticamente.</p>
</section>
<section class="card">
    <h2>Añadir aplicaciones</h2>
    <p>Busca, pulsa Añadir y listo. No necesitas subir instaladores ni escribir parámetros.</p>
    <p class="muted">Índice oficial WinGet: @(Catalog.IndexUpdatedAtUtc == DateTime.MinValue ? "pendiente de primera importación" : Catalog.IndexUpdatedAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm"))</p>
    <input aria-label="Buscar aplicación" placeholder="Nombre o identificador, por ejemplo Google.Chrome" @bind="_query" @bind:event="oninput" />
    @foreach (var app in Catalog.Search(_query))
    {
        <div class="job-row">
            <div class="job-title"><b>@app.Name</b><span>@app.Publisher · @app.Id · @app.Version</span></div>
            @if (app.Eligible)
            { <button disabled="@Catalog.Snapshot().Applications.Any(x => x.WingetId == app.Id)" @onclick="() => Change(() => Catalog.Add(app.Id))">Añadir</button> }
            else { <span class="muted">@app.Reason</span> }
        </div>
    }
</section>
<section class="card">
    <div class="card-head"><h2>Pack de aplicaciones</h2><button @onclick="Update">Actualizar todas las versiones</button></div>
    <p class="muted">Las versiones quedan fijadas hasta que pulses Actualizar. El instalador comprobará la compatibilidad real antes de empezar.</p>
    @if (_message is not null) { <p role="status">@_message</p> }
    @if (Catalog.Snapshot().Applications.Count == 0) { <p>Pack vacío. Busca una aplicación arriba para empezar.</p> }
    @foreach (var app in Catalog.Snapshot().Applications)
    {
        <div class="job-row" @key="app.Id">
            <div class="job-title"><b>@app.DisplayName</b><span>@app.WingetId · @app.PinnedVersion</span></div>
            <label><input type="checkbox" checked="@app.SelectedByDefault" @onchange="e => Change(() => Catalog.Configure(app.Id, (bool)(e.Value ?? false), app.Order))" /> Preseleccionada</label>
            <label>Orden <input aria-label="@($"Orden de {app.DisplayName}")" type="number" min="0" max="10000" value="@app.Order" @onchange="e => SetOrder(app, e.Value)" /></label>
            <button class="danger" @onclick="() => Change(() => Catalog.Remove(app.Id))">Retirar</button>
        </div>
    }
</section>
@code {
    private string _query = "";
    private string? _message, _bundleError;
    private ValidatedInitialSetupBundle? _bundle;
    protected override void OnInitialized() => _bundle = Bundles.Latest(out _bundleError);
    private void Change(Action action) { try { action(); _message = "Pack guardado."; } catch (Exception ex) { _message = ex.Message; } }
    private void SetOrder(PackApplication app, object? value) => Change(() => Catalog.Configure(app.Id, app.SelectedByDefault, int.TryParse(value?.ToString(), out int order) ? order : app.Order));
    private void Update()
    {
        try { var failed = Catalog.UpdateVersions(); _message = failed.Count == 0 ? "Versiones actualizadas." : "Se conserva la versión anterior de: " + string.Join(", ", failed); }
        catch (Exception ex) { _message = ex.Message; }
    }
}
