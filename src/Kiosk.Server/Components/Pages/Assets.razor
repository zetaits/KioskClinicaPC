@page "/imagenes"
@attribute [Authorize]
@rendermode InteractiveServer
@inject AssetLibrary Lib

<div class="asset-toolbar">
    <div class="search">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7" /><path d="m20 20-4-4" /></svg>
        <input aria-label="Buscar imágenes" placeholder="Buscar por nombre…" @bind="_search" @bind:event="oninput" />
    </div>
    <div class="asset-summary">
        <span class="dot online"></span>
        @Lib.Manifest().Files.Count imágenes publicadas · sincronización automática
    </div>
</div>

<AssetSection Category="Brands"
              Title="Marcas de equipos"
              Description="Logos que se muestran al reconocer el fabricante del ordenador."
              NameLabel="Nombre de la marca"
              Placeholder="Ej. Lenovo"
              Search="@_search" />

<AssetSection Category="SpecImages"
              Title="Imágenes de componentes"
              Description="Ilustraciones para CPU, GPU y sistema operativo en la ficha del equipo."
              NameLabel="Identificador del componente"
              Placeholder="Ej. intel core i7"
              Search="@_search" />

@code {
    private string _search = "";
}
