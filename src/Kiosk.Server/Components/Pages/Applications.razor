@page "/aplicaciones"
@attribute [Authorize]
@rendermode InteractiveServer
@inject NavigationManager Nav

<PackCatalogEditor />

@code {
    // Keep previously shared fleet/upload links working without mixing the two pages again.
    [SupplyParameterFromQuery(Name = "device")] public string? LegacyDevice { get; set; }
    [SupplyParameterFromQuery(Name = "ok")] public string? LegacyOk { get; set; }
    [SupplyParameterFromQuery(Name = "error")] public string? LegacyError { get; set; }
    protected override void OnParametersSet()
    {
        var parameters = new List<string>();
        if (!string.IsNullOrWhiteSpace(LegacyDevice)) parameters.Add("device=" + Uri.EscapeDataString(LegacyDevice));
        if (!string.IsNullOrWhiteSpace(LegacyOk)) parameters.Add("ok=" + Uri.EscapeDataString(LegacyOk));
        if (!string.IsNullOrWhiteSpace(LegacyError)) parameters.Add("error=" + Uri.EscapeDataString(LegacyError));
        if (parameters.Count > 0) Nav.NavigateTo("/ordenadores/instalaciones?" + string.Join("&", parameters), replace: true);
    }
}
