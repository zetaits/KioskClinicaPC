<Window x:Class="Kiosk.EquipmentSetup.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Preparar equipo · Clínica PC" Width="820" Height="650"
        MinWidth="680" MinHeight="540" WindowStartupLocation="CenterScreen" Background="#111315" Foreground="#E7E9ED"
        FontFamily="./Fonts/#Space Grotesk" FontSize="15" Closing="OnClosing">
    <Window.Resources>
        <Style TargetType="Button"><Setter Property="Padding" Value="20,10"/><Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="Background" Value="#F37A4A"/><Setter Property="Foreground" Value="#111315"/>
            <Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger></Style.Triggers>
        </Style>
        <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#E7E9ED"/><Setter Property="Margin" Value="0,10,0,10"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
        <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
    </Window.Resources>
    <Grid Margin="32">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel><TextBlock Text="CLÍNICA PC" Foreground="#F37A4A" FontWeight="Bold" FontSize="18"/>
            <TextBlock Text="Preparar este equipo" FontWeight="Bold" FontSize="30" Margin="0,8,0,4"/>
            <TextBlock x:Name="VersionLabel" Foreground="#B3B9C2"/></StackPanel>
        <TextBlock Grid.Row="1" x:Name="StepLabel" Foreground="#FFB069" Margin="0,24,0,18"/>
        <Border Grid.Row="2" Background="#191C20" BorderBrush="#30343B" BorderThickness="1" CornerRadius="10" Padding="24">
            <Grid>
                <StackPanel x:Name="ComponentsPanel">
                    <TextBlock Text="Elige qué quieres instalar" FontSize="22" FontWeight="Bold"/>
                    <CheckBox x:Name="PackCheck" IsChecked="True" Content="Pack de aplicaciones del panel" Checked="ComponentsChanged" Unchecked="ComponentsChanged"/>
                    <TextBlock Text="Revisa las aplicaciones y sus versiones antes de confirmar." Foreground="#B3B9C2"/>
                    <CheckBox x:Name="KioskCheck" IsChecked="False" Content="Kiosko Clínica PC" Checked="ComponentsChanged" Unchecked="ComponentsChanged"/>
                    <TextBlock Text="Instala el cliente y sus servicios. Podrás abrir Kiosk al terminar." Foreground="#B3B9C2"/>
                </StackPanel>
                <Grid x:Name="ApplicationsPanel" Visibility="Collapsed">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <TextBlock Text="Aplicaciones del pack" FontSize="22" FontWeight="Bold"/>
                    <TextBlock Grid.Row="1" x:Name="CatalogLabel" Foreground="#B3B9C2" Margin="0,12,0,10"/>
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"><ItemsControl x:Name="ApplicationsList">
                        <ItemsControl.ItemTemplate><DataTemplate>
                            <CheckBox IsChecked="{Binding Selected, Mode=TwoWay}" Checked="ApplicationChanged" Unchecked="ApplicationChanged">
                                <StackPanel><TextBlock Text="{Binding Application.DisplayName}"/><TextBlock Text="{Binding Application.PinnedVersion}" Foreground="#B3B9C2" FontSize="13"/></StackPanel>
                            </CheckBox>
                        </DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl></ScrollViewer>
                </Grid>
                <Grid x:Name="ExecutionPanel" Visibility="Collapsed">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <TextBlock x:Name="ExecutionTitle" Text="Comprobación e instalación" FontSize="22" FontWeight="Bold"/>
                    <TextBlock Grid.Row="1" x:Name="SummaryLabel" Margin="0,12,0,12" Foreground="#B3B9C2"/>
                    <CheckBox Grid.Row="2" x:Name="ResumeCheck" Content="Reanudar pendientes del estado local, comprobando lo ya instalado" IsChecked="True"/>
                    <ProgressBar Grid.Row="3" x:Name="Progress" Height="6" Visibility="Collapsed" Foreground="#F37A4A" Background="#30343B" Margin="0,0,0,16"/>
                    <TextBox Grid.Row="4" x:Name="Activity" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Background="Transparent" Foreground="#E7E9ED" BorderThickness="0"/>
                </Grid>
                <StackPanel x:Name="ResultPanel" Visibility="Collapsed">
                    <TextBlock x:Name="ResultTitle" FontSize="22" FontWeight="Bold"/>
                    <TextBlock x:Name="ResultLabel" Margin="0,16,0,12"/>
                    <TextBox x:Name="ResultDetails" MaxHeight="150" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Background="Transparent" Foreground="#E7E9ED" BorderThickness="0"/>
                    <TextBlock Text="Diagnósticos: %ProgramData%\ClinicaPC\Setup\logs. Los reinicios son siempre manuales." Foreground="#B3B9C2" Margin="0,8,0,12"/>
                    <CheckBox x:Name="LaunchCheck" Content="Abrir Kiosk al cerrar el asistente" IsChecked="False" Visibility="Collapsed"/>
                </StackPanel>
            </Grid>
        </Border>
        <DockPanel Grid.Row="3" Margin="0,22,0,0">
            <TextBlock x:Name="StatusLabel" Foreground="#B3B9C2" VerticalAlignment="Center" MaxWidth="330"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BackButton" Content="Atrás" Background="#30343B" Foreground="#E7E9ED" Click="Back" Visibility="Collapsed"/>
                <Button x:Name="RetryButton" Content="Reintentar" Click="Retry" Visibility="Collapsed"/>
                <Button x:Name="CancelButton" Content="Cancelar" Background="#30343B" Foreground="#E7E9ED" Click="Cancel"/>
                <Button x:Name="NextButton" Content="Continuar" Click="Next"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
